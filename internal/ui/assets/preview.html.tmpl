<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BenchMeister PC-Check</title>
<style>
  :root {
    --bg: #0d0a11; --panel: #16121c; --inset: #191420;
    --fg: #f4f1f7; --muted: #b3aabd; --faint: #7d7488;
    --line: #2b2434; --accent: #ec84f5; --ok: #4ade80; --warn: #fbbf24;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 32px 20px 64px;
    background: var(--bg); color: var(--fg);
    font: 15px/1.6 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  .huelle { max-width: 720px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 32px 0 12px; }
  .unter { color: var(--muted); margin: 0 0 8px; }
  .karte {
    border: 1px solid var(--line); background: var(--panel);
    border-radius: 12px; padding: 16px;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 0; border-bottom: 1px solid var(--line); }
  th { color: var(--faint); font-weight: 600; font-size: 13px;
       text-transform: uppercase; letter-spacing: .04em; width: 42%; }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  .nichts { color: var(--faint); }
  /* Befunde der Plausibilitaetspruefung. Der farbige Streifen links
     statt einer Hintergrundfarbe: Ein voll eingefaerbter Kasten liest
     sich wie eine Fehlermeldung, das hier sind aber Hinweise auf
     ungenutztes Potenzial, keine Fehler des Rechners. */
  .befund {
    border-left: 3px solid var(--line); padding: 2px 0 2px 14px;
    margin: 14px 0;
  }
  .befund.hinweis { border-left-color: var(--warn); }
  .befund.gut { border-left-color: var(--ok); }
  .befund .titel { font-weight: 600; margin-bottom: 2px; }
  .befund .rat { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .alles-gut { color: var(--ok); }
  details { margin-top: 12px; }
  summary { cursor: pointer; color: var(--muted); font-size: 14px; }
  pre {
    background: var(--inset); border: 1px solid var(--line); border-radius: 8px;
    padding: 12px; overflow-x: auto; font-size: 13px; color: var(--muted);
    margin-top: 10px;
  }
  .haken { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 16px; }
  .haken:last-of-type { margin-bottom: 0; }
  .haken input { margin-top: 3px; width: 17px; height: 17px; flex-shrink: 0; accent-color: var(--accent); }
  .haken label { cursor: pointer; }
  .haken .titel { display: block; font-weight: 600; }
  .haken .text { display: block; color: var(--muted); font-size: 14px; margin-top: 2px; }
  button {
    font: inherit; font-weight: 600; padding: 11px 20px; border-radius: 8px;
    border: 1px solid var(--line); background: var(--accent); color: #1b0a1f;
    cursor: pointer; margin-top: 20px;
  }
  button:disabled { background: var(--inset); color: var(--faint); cursor: not-allowed; }
  .fuss { color: var(--faint); font-size: 13px; margin-top: 28px; }
  .meldung { margin-top: 14px; font-size: 14px; }
  .meldung.fehler { color: var(--warn); }
  .meldung.gut { color: var(--ok); }
  a { color: var(--accent); }
</style>
</head>
<body>
<div class="huelle">

  <h1>BenchMeister PC-Check</h1>
  <p class="unter">
    Das haben wir in deinem Rechner gefunden. Bis hierhin ist noch nichts
    ins Internet gegangen, alles unten steht nur auf deinem Bildschirm.
  </p>

  <div class="karte">
    <table>
      <tr><th>Prozessor</th><td>{{.Scan.CPUName}}</td></tr>
      <tr><th>Kerne / Threads</th><td>{{.Scan.CPUCores}} / {{.Scan.CPUThreads}}</td></tr>
      <tr><th>Grafikkarte</th><td>{{.Scan.GPUName}}</td></tr>
      <tr><th>Grafikspeicher</th><td>
        {{if .Scan.GPUVramGb}}{{.Scan.GPUVramGb}} GB{{else}}<span class="nichts">von Windows nicht zuverlässig gemeldet</span>{{end}}
      </td></tr>
      {{/* MT/s, nicht MHz. Hier stand bis zum 29.08.2026 "MHz", und das
           ist bei DDR um den Faktor zwei falsch: 5600 MT/s sind 2800 MHz.
           Windows beschriftet das Feld selbst falsch, das ist aber kein
           Grund, den Fehler weiterzureichen. Die Befunde weiter unten
           sprachen ohnehin schon von MT/s, auf derselben Seite standen
           also zwei Einheiten fuer dieselbe Zahl. */}}
      <tr><th>Arbeitsspeicher</th><td>
        {{.Scan.RamTotalGb}} GB{{if .Scan.RamSpeedMhz}}, {{.Scan.RamSpeedMhz}} MT/s{{end}}
      </td></tr>
      {{/* Alle Laufwerke einzeln, nicht nur das groesste. Bis 29.08.2026
           stand hier nur StorageType und StorageCapacityGb, und das
           beschreibt allein den groessten Datentraeger. Ein Moderator im
           PCGH-Forum hatte deshalb fuenf Laufwerke im Rechner und sah nur
           eines, ausgerechnet die 3-TB-Festplatte, waehrend die Befunde
           darunter sehr wohl von seinen SSDs sprachen. Das sah aus, als
           wuerde das Programm sich selbst widersprechen.
           Die Angaben lagen schon vor, sie wurden nur nicht gezeigt. */}}
      {{if .Laufwerke}}
      {{range $i, $l := .Laufwerke}}
      <tr>
        <th>{{if eq $i 0}}Laufwerke{{end}}</th>
        <td>{{$l.Beschriftung}}</td>
      </tr>
      {{end}}
      {{else}}
      <tr><th>Laufwerk</th><td>{{.Scan.StorageType}}, {{.Scan.StorageCapacityGb}} GB</td></tr>
      {{end}}
      <tr><th>Auflösung</th><td>{{.Scan.ResolutionWidth}} × {{.Scan.ResolutionHeight}}</td></tr>
      {{if .Scan.MainboardName}}
      <tr><th>Mainboard</th><td>{{.Scan.MainboardName}} <span class="nichts">(nur hier, wird nicht übertragen)</span></td></tr>
      {{end}}
    </table>

    <details>
      <summary>Rohdaten ansehen: genau das würde übertragen</summary>
      <pre id="rohdaten">{{.RohdatenJSON}}</pre>
      <p class="fuss" style="margin-top:8px">
        Nicht dabei und wird auch nie erhoben: Seriennummern, MAC-Adresse,
        BIOS-Kennung, dein Windows-Benutzername, der Rechnername und die
        Liste installierter Programme.
      </p>
    </details>
  </div>

  {{/* Plausibilitaetspruefung. Steht bewusst VOR der Zustimmungsfrage:
       Sie ist der Teil, der auch dann etwas bringt, wenn jemand nichts
       uebertragen moechte. Sie beruht ausschliesslich auf Angaben, die
       ohnehin schon ausgelesen wurden, und laeuft rein rechnerisch. */}}
  <h2>Holst du alles heraus?</h2>
  {{/* Zwei getrennte Karten seit 28.08.2026. Vorher standen alle Befunde
       unter der Zeile "ohne dass du etwas kaufen musst", darunter aber
       auch Ratschlaege, die auf einen Neukauf hinauslaufen (SATA-SSD
       gegen NVMe, Festplatte gegen SSD). Ein Moderator im PCGH-Forum hat
       das zu Recht angestrichen. Eine Ueberschrift, die nicht stimmt,
       beschaedigt alles darunter mit. */}}
  {{if .Kostenlos}}
  <div class="karte">
    <p class="unter" style="margin-bottom:4px">
      Das hier kostet dich gerade Leistung, ohne dass du etwas kaufen musst.
    </p>
    {{range .Kostenlos}}
    <div class="befund {{if eq .Schwere "hinweis"}}hinweis{{end}}">
      <div class="titel">{{.Titel}}</div>
      <div>{{.Feststellung}}</div>
      <div class="rat">{{.Empfehlung}}</div>
    </div>
    {{end}}
    <p class="fuss" style="margin-top:12px">
      Diese Prüfung vergleicht nur, was Windows ohnehin meldet. Es wurde
      nichts gemessen, nichts belastet und nichts am System verändert.
    </p>
  </div>
  {{end}}
  {{if .Kostenpflichtig}}
  <div class="karte">
    <p class="unter" style="margin-bottom:4px">
      Das hier ginge schneller, kostet aber Geld. Muss also niemand machen.
    </p>
    {{range .Kostenpflichtig}}
    <div class="befund">
      <div class="titel">{{.Titel}}</div>
      <div>{{.Feststellung}}</div>
      <div class="rat">{{.Empfehlung}}</div>
    </div>
    {{end}}
  </div>
  {{end}}
  {{/* Was schon richtig laeuft. Ergaenzt am 29.08.2026 nach einem
       Vorschlag von "Misanthrop68" im PCGH-Forum: Ohne eine positive
       Rueckmeldung kann ein Neuling Schweigen nicht von Uebersehen
       unterscheiden. Eigene Karte, damit die Ueberschrift der Fund-Karte
       darueber wahr bleibt. */}}
  {{if .Laeuft}}
  <div class="karte">
    <p class="unter" style="margin-bottom:4px">
      Das läuft schon so, wie es soll.
    </p>
    {{range .Laeuft}}
    <div class="befund gut">
      <div class="titel">{{.Titel}}</div>
      <div>{{.Feststellung}}</div>
      <div class="rat">{{.Empfehlung}}</div>
    </div>
    {{end}}
  </div>
  {{end}}

  {{/* Greift jetzt nur noch, wenn es WIRKLICH nichts zu sagen gibt, also
       auch keine Bestaetigung. Das ist der Fall, wenn die Teilenummer der
       Riegel unbekannt ist und deshalb kein Soll-Takt feststeht. */}}
  {{if not .Befunde}}
  <div class="karte">
    <p class="alles-gut" style="margin:0">
      Nichts gefunden. Es gab aber auch nichts, woran sich der
      Speichertakt hätte messen lassen: Zu deinen Riegeln ist hier keine
      Sollgeschwindigkeit hinterlegt. Die Laufwerke hängen dort, wo sie
      hingehören.
    </p>
  </div>
  {{end}}

  <h2>Möchtest du dein Ergebnis online sehen?</h2>

  <div class="karte">
    <div class="haken">
      <input type="checkbox" id="anzeigen">
      <label for="anzeigen">
        <span class="titel">Ergebnis auf BenchMeister ansehen</span>
        {{/* Der letzte Satz ist am 29.08.2026 dazugekommen, nach einer
             Rueckmeldung von "Zyxx" im HardwareLuxx-Forum: Dass die
             Ergebnisseite Kauflinks traegt, an denen mitverdient wird,
             "koennte noch ausdruecklicher erwaehnt werden".

             Er hat recht. Beim zweiten Haken stand die Finanzierung
             ausdruecklich dabei, beim ersten nicht, obwohl auch dort
             Geld im Spiel ist. Wer zustimmt, soll wissen, worauf er
             klickt, bevor er klickt, nicht erst auf der Zielseite. */}}
        <span class="text">
          Die Angaben oben werden hochgeladen, damit wir dir deinen Score,
          den Vergleich mit starken Komplettsystemen und Aufrüst-Vorschläge
          zeigen können. Du bekommst dafür einen persönlichen Link.
          Offen gesagt: Auf dieser Ergebnisseite stehen auch Kauflinks, an
          denen wir mitverdienen. Sie sind als Werbung gekennzeichnet, und
          welche Bauteile empfohlen werden, entscheidet die Rangliste, nicht
          die Provision.
        </span>
      </label>
    </div>

    <div class="haken">
      <input type="checkbox" id="marktforschung">
      <label for="marktforschung">
        <span class="titel">Zusätzlich: für Marktforschung freigeben (freiwillig)</span>
        <span class="text">
          Erlaubt uns, deine anonymen Angaben in eine Gesamtstatistik
          einfließen zu lassen, die wir an Hersteller und Händler
          weitergeben können. Damit finanzieren wir BenchMeister mit.
          Völlig unabhängig vom ersten Häkchen: Wenn du nur dein Ergebnis
          sehen willst, lass dieses hier einfach leer.
        </span>
      </label>
    </div>

    <button id="senden" disabled>Ergebnis ansehen</button>
    <div id="meldung" class="meldung"></div>
  </div>

  <p class="fuss">
    Ohne Klick auf den Knopf passiert nichts. Du kannst dieses Fenster
    einfach schließen, dann wurde nie etwas übertragen. Das Programm
    verändert nichts an deinem System, trägt sich nirgends ein und ist nach
    dem Schließen wieder weg.
  </p>

</div>

<script>
  const anzeigen = document.getElementById("anzeigen");
  const marktforschung = document.getElementById("marktforschung");
  const senden = document.getElementById("senden");
  const meldung = document.getElementById("meldung");
  const rohdaten = document.getElementById("rohdaten");

  // Der Rohdaten-Block muss ehrlich bleiben: Sobald sich das zweite
  // Häkchen ändert, ändert sich auch der Wert, der wirklich gesendet wird.
  // Deshalb wird die Anzeige mitgeführt statt einmal fest eingesetzt.
  function rohdatenAktualisieren() {
    try {
      const daten = JSON.parse(rohdaten.textContent);
      daten.p_consent_market_research = marktforschung.checked;
      rohdaten.textContent = JSON.stringify(daten, null, 2);
    } catch (e) { /* Anzeige ist Beiwerk, darf nie den Ablauf stören */ }
  }

  anzeigen.addEventListener("change", () => {
    senden.disabled = !anzeigen.checked;
  });
  marktforschung.addEventListener("change", rohdatenAktualisieren);

  /* Beim Laden EINMAL beide Zustaende nachziehen. Sieht ueberfluessig
     aus, ist es aber nicht: Firefox stellt beim Neuladen (F5) die
     Haekchen wieder her, ohne dabei ein change-Ereignis auszuloesen.
     Ohne diese zwei Zeilen passierte danach Folgendes:

     - Das erste Haekchen ist sichtbar gesetzt, der Knopf bleibt aber
       grau, weil er im HTML fest auf disabled steht. Sieht nach einem
       kaputten Programm aus.
     - Schlimmer: Ist das zweite Haekchen wiederhergestellt, steht im
       Rohdaten-Block weiterhin p_consent_market_research: false,
       gesendet wuerde aber true. Genau darueber steht die Zusage
       "genau das würde übertragen". Ein Block, der die Zustimmung
       falsch anzeigt, ist schlimmer als gar keiner.

     Gefunden bei der Durchsicht vor 1.0.6 am 29.08.2026. */
  senden.disabled = !anzeigen.checked;
  rohdatenAktualisieren();

  senden.addEventListener("click", async () => {
    senden.disabled = true;
    meldung.className = "meldung";
    meldung.textContent = "Wird übertragen ...";

    try {
      const antwort = await fetch("/consent", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          anzeigen: anzeigen.checked,
          marktforschung: marktforschung.checked,
        }),
      });
      const ergebnis = await antwort.json();

      if (!antwort.ok || ergebnis.fehler) {
        throw new Error(ergebnis.fehler || "Übertragung fehlgeschlagen");
      }

      meldung.className = "meldung gut";
      // Kein innerHTML mit zusammengebautem HTML: ergebnis.url kommt aus
      // der Antwort des Servers und damit mittelbar aus einer fremden
      // Antwort. Hier stand vorher eine Zeichenketten-Verkettung in ein
      // href-Attribut. Ausnutzbar waere das nur, wenn jemand die Antwort
      // von BenchMeister kontrolliert, aber die saubere Variante kostet
      // zwei Zeilen. Sicherheitsdurchsicht 27.08.2026.
      meldung.textContent = "Fertig. Dein Ergebnis: ";
      const verweis = document.createElement("a");
      verweis.href = ergebnis.url;
      verweis.textContent = ergebnis.url;
      meldung.appendChild(verweis);
      window.location.href = ergebnis.url;
    } catch (fehler) {
      meldung.className = "meldung fehler";
      meldung.textContent = "Hat nicht geklappt: " + fehler.message;
      senden.disabled = false;
    }
  });

  /* Anwesenheitsmeldung: ein Aufruf, der absichtlich nie beantwortet
     wird. Solange diese Seite offen ist, steht die Verbindung. Wird der
     Reiter geschlossen, bricht sie ab, und das Programm beendet sich.

     Das ist der verlaessliche Weg. Das sendBeacon weiter unten kam beim
     harten Schliessen eines Reiters nicht immer an, und ein Herzschlag
     per Zeitgeber wuerde in unsichtbaren Reitern gedrosselt. Die
     Begruendung im Langen steht in server.go bei /anwesend. */
  fetch("/anwesend").catch(function () {});

  /* Zusaetzlich, weil es schneller ist, wenn es denn ankommt:
     dem Programm Bescheid sagen, wenn diese Seite zugemacht wird.
     Ohne das lief die exe nach dem Schliessen des Fensters noch bis zu
     15 Minuten im Hintergrund weiter. Aus Sicht der Benutzerin ist diese
     Seite das Programm, also muss das Schliessen es auch beenden.
     Gefunden im PCGH-Forum am 28.08.2026.

     pagehide statt unload: unload verhindert, dass der Browser die Seite
     in seinen Vor-und-Zurueck-Speicher legt, und wird in mobilen
     Browsern oft gar nicht ausgeloest.

     sendBeacon statt fetch: Es ueberlebt das Schliessen des Fensters,
     ein normaler Aufruf wuerde dabei abgebrochen. */
  window.addEventListener("pagehide", function () {
    if (navigator.sendBeacon) {
      navigator.sendBeacon("/verlassen");
      return;
    }
    fetch("/verlassen", { method: "POST", keepalive: true }).catch(function () {});
  });

  /* Kommt die Seite ueber den Zurueck-Knopf aus dem Vor-und-Zurueck-
     Speicher, laedt der Browser sie nicht neu. Dann fehlt der Aufruf,
     der den Abschied von eben abblasen wuerde, also hier nachholen. */
  window.addEventListener("pageshow", function (ereignis) {
    if (ereignis.persisted) {
      fetch("/bleibt").catch(function () {});
    }
  });
</script>
</body>
</html>
