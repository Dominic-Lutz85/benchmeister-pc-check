<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>BenchMeister PC-Check</title>
<style>
  :root {
    --bg: #0d0a11; --panel: #16121c; --inset: #191420;
    --fg: #f4f1f7; --muted: #b3aabd; --faint: #7d7488;
    --line: #2b2434; --accent: #ec84f5; --ok: #4ade80; --warn: #fbbf24;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 32px 20px 64px;
    background: var(--bg); color: var(--fg);
    font: 15px/1.6 -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  .huelle { max-width: 720px; margin: 0 auto; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 32px 0 12px; }
  .unter { color: var(--muted); margin: 0 0 8px; }
  .karte {
    border: 1px solid var(--line); background: var(--panel);
    border-radius: 12px; padding: 16px;
  }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 8px 0; border-bottom: 1px solid var(--line); }
  th { color: var(--faint); font-weight: 600; font-size: 13px;
       text-transform: uppercase; letter-spacing: .04em; width: 42%; }
  tr:last-child th, tr:last-child td { border-bottom: 0; }
  .nichts { color: var(--faint); }
  /* Befunde der Plausibilitaetspruefung. Der farbige Streifen links
     statt einer Hintergrundfarbe: Ein voll eingefaerbter Kasten liest
     sich wie eine Fehlermeldung, das hier sind aber Hinweise auf
     ungenutztes Potenzial, keine Fehler des Rechners. */
  .befund {
    border-left: 3px solid var(--line); padding: 2px 0 2px 14px;
    margin: 14px 0;
  }
  .befund.hinweis { border-left-color: var(--warn); }
  .befund.gut { border-left-color: var(--ok); }
  /* Der Aufklapper, ergaenzt am 30.08.2026. Die Begruendungen standen
     vorher offen im Befund und machten ihn bis zu 590 Zeichen lang.
     Ruecksmeldung von "Hellhammer" im PCGH-Forum: zu viel begruendet,
     zu ausformuliert. Er hatte recht.
     Bewusst ein natives <details>: kein Skript noetig, funktioniert
     auch ohne JavaScript, und der Text ist fuer Suchfunktion und
     Vorlesewerkzeuge trotzdem da. */
  .mehr { margin-top: 8px; font-size: 13px; color: var(--muted); }
  .mehr summary { cursor: pointer; color: var(--accent); user-select: none; }
  .mehr summary:hover { text-decoration: underline; }
  .mehr[open] summary { margin-bottom: 6px; }
  .befund .titel { font-weight: 600; margin-bottom: 2px; }
  .befund .rat { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .alles-gut { color: var(--ok); }
  details { margin-top: 12px; }
  summary { cursor: pointer; color: var(--muted); font-size: 14px; }
  pre {
    background: var(--inset); border: 1px solid var(--line); border-radius: 8px;
    padding: 12px; overflow-x: auto; font-size: 13px; color: var(--muted);
    margin-top: 10px;
  }
  .haken { display: flex; gap: 10px; align-items: flex-start; margin-bottom: 16px; }
  .haken:last-of-type { margin-bottom: 0; }
  .haken input { margin-top: 3px; width: 17px; height: 17px; flex-shrink: 0; accent-color: var(--accent); }
  .haken label { cursor: pointer; }
  .haken .titel { display: block; font-weight: 600; }
  .haken .text { display: block; color: var(--muted); font-size: 14px; margin-top: 2px; }
  button {
    font: inherit; font-weight: 600; padding: 11px 20px; border-radius: 8px;
    border: 1px solid var(--line); background: var(--accent); color: #1b0a1f;
    cursor: pointer; margin-top: 20px;
  }
  button:disabled { background: var(--inset); color: var(--faint); cursor: not-allowed; }
  .fuss { color: var(--faint); font-size: 13px; margin-top: 28px; }
  .meldung { margin-top: 14px; font-size: 14px; }
  .meldung.fehler { color: var(--warn); }
  .meldung.gut { color: var(--ok); }

  /* Lasttest, ergaenzt am 06.09.2026. */
  .verlauf {
    height: 46px; display: flex; align-items: flex-end; gap: 2px;
    margin: 12px 0 8px;
  }
  .verlauf i { flex: 1; background: var(--accent); border-radius: 1px 1px 0 0; display: block; min-height: 2px; }
  .messwerte { display: flex; flex-wrap: wrap; gap: 22px; margin: 10px 0 0; }
  .messwerte div { min-width: 96px; }
  .messwerte b { display: block; font-size: 20px; font-variant-numeric: tabular-nums; }
  .messwerte span { color: var(--muted); font-size: 12px; }
  .urteil-gut b, .urteil-gut { color: var(--ok); }
  .urteil-mittel b, .urteil-mittel { color: var(--warn); }
  .urteil-schlecht b, .urteil-schlecht { color: var(--warn); }
  input[type="text"] {
    width: 100%; padding: 10px 12px; border-radius: 8px;
    border: 1px solid var(--line); background: var(--inset);
    color: var(--fg); font: inherit; margin-bottom: 10px;
  }
  input[type="text"]:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .knopfzeile { display: flex; gap: 10px; flex-wrap: wrap; }
  .still {
    background: transparent; color: var(--accent);
    border: 1px solid var(--line);
  }
  .schluessel {
    font-family: ui-monospace, monospace; font-size: 13px; word-break: break-all;
    background: var(--inset); padding: 10px 12px; border-radius: 8px; margin: 10px 0 0;
  }
  a { color: var(--accent); }
</style>
</head>
<body>
<div class="huelle">

  <h1>BenchMeister PC-Check</h1>
  {{/* Die Zusicherung "noch nichts ins Internet gegangen" stand bis zum
       06.09.2026 hier oben. Sie ist wahr und sie gehoert dazu, aber als
       zweiter Satz der Seite wirkt sie wie eine Warnung: Wer ueberfliegt,
       liest "Internet" und ist misstrauisch, bevor er ueberhaupt etwas
       gesehen hat. Sie steht jetzt unten bei der Entscheidung, fuer die
       sie gilt, direkt unter dem Knopf. Dort beruhigt sie, statt zu
       warnen. */}}
  <p class="unter">
    Das haben wir in deinem Rechner gefunden. Alles hier steht nur auf
    deinem Bildschirm.
  </p>

  <div class="karte">
    <table>
      <tr><th>Prozessor</th><td>{{.Scan.CPUName}}</td></tr>
      <tr><th>Kerne / Threads</th><td>{{.Scan.CPUCores}} / {{.Scan.CPUThreads}}</td></tr>
      <tr><th>Grafikkarte</th><td>{{.Scan.GPUName}}</td></tr>
      <tr><th>Grafikspeicher</th><td>
        {{if .Scan.GPUVramGb}}{{.Scan.GPUVramGb}} GB{{else}}<span class="nichts">von Windows nicht zuverlässig gemeldet</span>{{end}}
      </td></tr>
      {{/* MT/s, nicht MHz. Hier stand bis zum 29.08.2026 "MHz", und das
           ist bei DDR um den Faktor zwei falsch: 5600 MT/s sind 2800 MHz.
           Windows beschriftet das Feld selbst falsch, das ist aber kein
           Grund, den Fehler weiterzureichen. Die Befunde weiter unten
           sprachen ohnehin schon von MT/s, auf derselben Seite standen
           also zwei Einheiten fuer dieselbe Zahl. */}}
      {{/* Die Steckplatzbelegung, ergaenzt am 30.08.2026 auf die Frage
           von "Misanthrop68" im PCGH-Forum: "Kann Windows die Anzahl
           auslesen?" Kann es, in Win32_PhysicalMemoryArray.

           Warum das dazugehoert: "32 GB, 4 Riegel" sagt nichts ueber
           den Ausbau. Vier von vier heisst voll, vier von acht heisst
           halb, und zwei von zwei heisst, dass Nachruesten nur durch
           Austauschen geht. Diese Zahl beantwortet die Frage "kann ich
           noch was dazustecken" ohne Gehaeuse aufschrauben.

           Nur wenn beide Zahlen bekannt sind. Die Steckplatzzahl kommt
           wie alles hier aus einer Tabelle des Board-Herstellers und
           fehlt bei manchen. */}}
      <tr><th>Arbeitsspeicher</th><td>
        {{.Scan.RamTotalGb}} GB{{if .Scan.RamSpeedMhz}}, {{.Scan.RamSpeedMhz}} MT/s{{end}}{{if and .Scan.RamSteckplaetze .Scan.Riegel}}, {{len .Scan.Riegel}} von {{.Scan.RamSteckplaetze}} Steckplätzen belegt{{end}}
      </td></tr>
      {{/* Alle Laufwerke einzeln, nicht nur das groesste. Bis 29.08.2026
           stand hier nur StorageType und StorageCapacityGb, und das
           beschreibt allein den groessten Datentraeger. Ein Moderator im
           PCGH-Forum hatte deshalb fuenf Laufwerke im Rechner und sah nur
           eines, ausgerechnet die 3-TB-Festplatte, waehrend die Befunde
           darunter sehr wohl von seinen SSDs sprachen. Das sah aus, als
           wuerde das Programm sich selbst widersprechen.
           Die Angaben lagen schon vor, sie wurden nur nicht gezeigt. */}}
      {{if .Laufwerke}}
      {{range $i, $l := .Laufwerke}}
      <tr>
        <th>{{if eq $i 0}}Laufwerke{{end}}</th>
        <td>{{$l.Beschriftung}}</td>
      </tr>
      {{end}}
      {{else}}
      <tr><th>Laufwerk</th><td>{{.Scan.StorageType}}, {{.Scan.StorageCapacityGb}} GB</td></tr>
      {{end}}
      {{/* PCIe-Anbindung, ergaenzt am 01.09.2026 auf den Wunsch von
           "Logos_Atum" im PCGH-Forum: sehen, mit wie vielen Leitungen
           was angebunden ist.

           HIER STEHT ABSICHTLICH KEIN URTEIL. Keine Farbe, kein "zu
           wenig", keine Empfehlung, und weiter unten auch kein Befund.
           Zwei unabhaengige Gruende, beide nachgemessen und beide im
           aufklappbaren Block darunter erklaert: Der von Windows
           gemeldete Hoechstwert stimmt nicht, und im Leerlauf sind auch
           die Ist-Werte niedriger als unter Last.

           Zeigen und einordnen ist hier ehrlich, warnen waere es
           nicht. */}}
      {{if .Pcie}}
      {{range $i, $p := .Pcie}}
      <tr>
        <th>{{if eq $i 0}}PCIe-Anbindung{{end}}</th>
        <td>{{$p.Beschriftung}}</td>
      </tr>
      {{end}}
      <tr>
        <th></th>
        <td>
          <details class="mehr">
            <summary>Warum hier keine Bewertung steht</summary>
            <p>
              Diese Zahlen sind eine Momentaufnahme im Leerlauf. Sie sagen,
              in welchem Modus deine Karte und deine SSDs gerade laufen,
              nicht ob damit etwas nicht stimmt. Zwei Gründe, warum wir
              daraus keine Warnung machen:
            </p>
            <p>
              <strong>Stromsparen senkt die Werte.</strong> Wenn nichts zu
              tun ist, fährt die Verbindung Generation und Breite herunter.
              Das ist gewolltes Verhalten und kein Fehler. Programme wie
              GPU-Z haben deshalb einen Last-Test, der die Verbindung erst
              hochzwingt, bevor sie ablesen. Dieses Programm erzeugt
              ausdrücklich keine Last, es kann also nicht unterscheiden
              zwischen „hängt dauerhaft an zu wenigen Leitungen“ und
              „döst gerade“.
            </p>
            <p>
              <strong>Der gemeldete Höchstwert stimmt nicht.</strong>
              Windows nennt zu jedem Gerät auch ein Maximum, und es liegt
              nahe, beides zu vergleichen. Auf unserem eigenen
              Testrechner meldet eine GeForce RTX 5060 Ti als Maximum
              x16, obwohl diese Karte von Haus aus mit acht Leitungen
              gebaut ist und die andere Hälfte der Kontakte gar nicht
              angeschlossen hat. Eine Regel „aktuell kleiner als maximal,
              also Warnung“ hätte dort Alarm geschlagen, wo alles in
              Ordnung ist. Deshalb steht das Maximum hier gar nicht erst.
            </p>
            <p>
              Wenn du es genau wissen willst: ein Spiel starten, es laufen
              lassen und danach noch einmal messen. Unter Last ist der
              Wert aussagekräftig.
            </p>
          </details>
        </td>
      </tr>
      {{end}}
      <tr><th>Auflösung</th><td>{{.Scan.ResolutionWidth}} × {{.Scan.ResolutionHeight}}</td></tr>
      {{if .Scan.MainboardName}}
      <tr><th>Mainboard</th><td>{{.Scan.MainboardName}} <span class="nichts">(nur hier, wird nicht übertragen)</span></td></tr>
      {{end}}
    </table>

    <details>
      <summary>Rohdaten ansehen: genau das würde übertragen</summary>
      <pre id="rohdaten">{{.RohdatenJSON}}</pre>
      <p class="fuss" style="margin-top:8px">
        Nicht dabei und wird auch nie erhoben: Seriennummern, MAC-Adresse,
        BIOS-Kennung, dein Windows-Benutzername, der Rechnername und die
        Liste installierter Programme.
      </p>
    </details>
  </div>

  {{/* Plausibilitaetspruefung. Steht bewusst VOR der Zustimmungsfrage:
       Sie ist der Teil, der auch dann etwas bringt, wenn jemand nichts
       uebertragen moechte. Sie beruht ausschliesslich auf Angaben, die
       ohnehin schon ausgelesen wurden, und laeuft rein rechnerisch. */}}
  <h2>Holst du alles heraus?</h2>
  {{/* Zwei getrennte Karten seit 28.08.2026. Vorher standen alle Befunde
       unter der Zeile "ohne dass du etwas kaufen musst", darunter aber
       auch Ratschlaege, die auf einen Neukauf hinauslaufen (SATA-SSD
       gegen NVMe, Festplatte gegen SSD). Ein Moderator im PCGH-Forum hat
       das zu Recht angestrichen. Eine Ueberschrift, die nicht stimmt,
       beschaedigt alles darunter mit. */}}
  {{if .Kostenlos}}
  <div class="karte">
    <p class="unter" style="margin-bottom:4px">
      Das hier kostet dich gerade Leistung, ohne dass du etwas kaufen musst.
    </p>
    {{range .Kostenlos}}
    <div class="befund {{if eq .Schwere "hinweis"}}hinweis{{end}}">
      <div class="titel">{{.Titel}}</div>
      <div>{{.Feststellung}}</div>
      <div class="rat">{{.Empfehlung}}</div>
      {{if .Hintergrund}}<details class="mehr"><summary>Warum?</summary>{{.Hintergrund}}</details>{{end}}
    </div>
    {{end}}
    <p class="fuss" style="margin-top:12px">
      Diese Prüfung vergleicht nur, was Windows ohnehin meldet. Es wurde
      nichts gemessen, nichts belastet und nichts am System verändert.
    </p>
  </div>
  {{end}}
  {{if .Kostenpflichtig}}
  <div class="karte">
    <p class="unter" style="margin-bottom:4px">
      Das hier ginge schneller, kostet aber Geld. Muss also niemand machen.
    </p>
    {{range .Kostenpflichtig}}
    <div class="befund">
      <div class="titel">{{.Titel}}</div>
      <div>{{.Feststellung}}</div>
      <div class="rat">{{.Empfehlung}}</div>
      {{if .Hintergrund}}<details class="mehr"><summary>Warum?</summary>{{.Hintergrund}}</details>{{end}}
    </div>
    {{end}}
  </div>
  {{end}}
  {{/* Was schon richtig laeuft. Ergaenzt am 29.08.2026 nach einem
       Vorschlag von "Misanthrop68" im PCGH-Forum: Ohne eine positive
       Rueckmeldung kann ein Neuling Schweigen nicht von Uebersehen
       unterscheiden. Eigene Karte, damit die Ueberschrift der Fund-Karte
       darueber wahr bleibt. */}}
  {{if .Laeuft}}
  <div class="karte">
    <p class="unter" style="margin-bottom:4px">
      Das läuft schon so, wie es soll.
    </p>
    {{range .Laeuft}}
    <div class="befund gut">
      <div class="titel">{{.Titel}}</div>
      <div>{{.Feststellung}}</div>
      <div class="rat">{{.Empfehlung}}</div>
      {{if .Hintergrund}}<details class="mehr"><summary>Warum?</summary>{{.Hintergrund}}</details>{{end}}
    </div>
    {{end}}
  </div>
  {{end}}

  {{/* Greift jetzt nur noch, wenn es WIRKLICH nichts zu sagen gibt, also
       auch keine Bestaetigung. Das ist der Fall, wenn die Teilenummer der
       Riegel unbekannt ist und deshalb kein Soll-Takt feststeht. */}}
  {{if not .Befunde}}
  <div class="karte">
    <p class="alles-gut" style="margin:0">
      Nichts gefunden. Es gab aber auch nichts, woran sich der
      Speichertakt hätte messen lassen: Zu deinen Riegeln ist hier keine
      Sollgeschwindigkeit hinterlegt. Die Laufwerke hängen dort, wo sie
      hingehören.
    </p>
  </div>
  {{end}}

  {{/* UEBERSCHRIFT GEAENDERT AM 06.09.2026. Vorher: "Moechtest du dein
       Ergebnis online sehen?" Das ist eine Bitte um Erlaubnis, und eine
       Bitte beantwortet man am schnellsten mit nein.

       Die neue Fassung stellt die Frage, die der Besucher ohnehin im Kopf
       hat, seit er die Messwerte gesehen hat. Beantworten laesst sie sich
       nur mit dem Vergleich, und dafuer muessen die Angaben eben hoch.
       Der Unterschied ist nicht Werbung, sondern Reihenfolge: erst wozu,
       dann was dafuer noetig ist.

       Die Wahl fiel am 06.09.2026 zwischen drei Fassungen, siehe die
       Erkundung "Laeuft meine Kiste richtig?". Gewaehlt wurde die
       Rangliste, weil sie den Ehrgeiz anspricht, der Leute ueberhaupt
       dazu bringt, so ein Programm zu starten. Das Namensfeld dazu fehlt
       hier noch mit Absicht: Es gibt die Rangliste noch nicht, und ein
       Eingabefeld ohne etwas dahinter waere eine Attrappe. */}}
  {{/* MESSUNG UND RANGLISTE, ergaenzt am 06.09.2026.

       Bis hierher liest dieses Programm nur ab. Damit ist die Frage, die
       die meisten wirklich haben, gar nicht zu beantworten: Laeuft meine
       Kiste so wie sie soll, oder habe ich ein Montagsmodell? Zwei
       Rechner mit derselben Teileliste koennen zwanzig Prozent
       auseinanderliegen.

       Gemessen wird der gehaltene Takt, nicht die Temperatur. Die
       Temperatur ist ohne Kernel-Treiber auf den meisten Rechnern gar
       nicht lesbar, der Takt schon, und er ist die ehrlichere Zahl: Er
       ist das Ergebnis von Kuehlung, Power-Limit, Belueftung,
       Waermeleitpaste und Staub zusammen.

       DER ABSCHNITT STEHT VOR DER ZUSTIMMUNGSFRAGE, nicht dahinter. Wer
       gemessen hat, hat einen Grund mehr, sein Ergebnis sehen zu wollen.
       Umgekehrt waere die Messung ein Nachklapp. */}}
  <h2>Wie gut hält deine Kühlung?</h2>

  <div class="karte" id="messkarte">
    <div id="mess-start">
      <p class="unter" style="margin-bottom:12px">
        Wir lassen deinen Prozessor zwei Minuten rechnen und schreiben mit,
        wie viel Takt er dabei hält. Fällt er ab, liegt es an der Kühlung,
        am Staub oder an alter Wärmeleitpaste.
      </p>
      <div class="haken">
        <input type="checkbox" id="messen-ok">
        <label for="messen-ok">
          <span class="titel">Zwei Minuten messen</span>
          <span class="text">
            Ein Kern bleibt frei, damit du weiterarbeiten kannst. Die Last
            ist nicht höher als bei einem anspruchsvollen Spiel, und du
            kannst jederzeit abbrechen. Am System wird nichts verändert.
          </span>
        </label>
      </div>
      <button id="mess-knopf" disabled>Messung starten</button>
    </div>

    <div id="mess-lauf" hidden>
      <p class="unter" id="mess-fortschritt">Läuft ...</p>
      <div class="verlauf" id="mess-verlauf"></div>
      <div class="knopfzeile">
        <button class="still" id="mess-abbruch">Abbrechen</button>
      </div>
    </div>

    <div id="mess-fertig" hidden>
      <p class="unter" id="mess-urteil" style="margin-bottom:0"></p>
      <div class="messwerte">
        <div><b id="mess-gehalten">–</b><span>gehalten</span></div>
        <div><b id="mess-dauer">–</b><span>unter Dauerlast</span></div>
        <div><b id="mess-spitze">–</b><span>Spitze</span></div>
      </div>

      <div id="eintrag" style="margin-top:18px">
        <p class="unter" style="margin-bottom:8px">
          <strong style="color:var(--fg)">Trag dich in die Rangliste ein.</strong>
          Such dir einen Namen aus, unter dem deine Messung dort steht.
        </p>
        <input type="text" id="alias" maxlength="20" placeholder="Dein Name in der Liste"
               autocomplete="off" spellcheck="false">
        <div class="knopfzeile">
          <button id="eintrag-knopf" disabled>Eintragen</button>
        </div>
        <p class="unter" style="margin:10px 0 0;font-size:12px">
          Übertragen werden Name, Prozessor, Grafikkarte, Betriebssystem und
          die drei Taktwerte von oben. Keine Seriennummer, keine Adresse,
          kein Rechnername.
        </p>
        <div id="eintrag-meldung" class="meldung"></div>
      </div>
    </div>
  </div>

  <h2>Dein Ergebnis auf BenchMeister</h2>
  <p class="unter" style="margin-top:-8px">
    Der ausführliche Vergleich mit starken Komplettsystemen, dein Score und
    Aufrüst-Vorschläge, auf einer Seite unter deinem eigenen Link.
  </p>

  <div class="karte">
    <div class="haken">
      <input type="checkbox" id="anzeigen">
      <label for="anzeigen">
        <span class="titel">Ergebnis auf BenchMeister ansehen</span>
        {{/* Der letzte Satz ist am 29.08.2026 dazugekommen, nach einer
             Rueckmeldung von "Zyxx" im HardwareLuxx-Forum: Dass die
             Ergebnisseite Kauflinks traegt, an denen mitverdient wird,
             "koennte noch ausdruecklicher erwaehnt werden".

             Er hat recht. Beim zweiten Haken stand die Finanzierung
             ausdruecklich dabei, beim ersten nicht, obwohl auch dort
             Geld im Spiel ist. Wer zustimmt, soll wissen, worauf er
             klickt, bevor er klickt, nicht erst auf der Zielseite. */}}
        <span class="text">
          Die Angaben oben werden hochgeladen, damit wir dir deinen Score,
          den Vergleich mit starken Komplettsystemen und Aufrüst-Vorschläge
          zeigen können. Du bekommst dafür einen persönlichen Link.
          Offen gesagt: Auf dieser Ergebnisseite stehen auch Kauflinks, an
          denen wir mitverdienen. Sie sind als Werbung gekennzeichnet, und
          welche Bauteile empfohlen werden, entscheidet die Rangliste, nicht
          die Provision.
        </span>
      </label>
    </div>

    <div class="haken">
      <input type="checkbox" id="marktforschung">
      <label for="marktforschung">
        <span class="titel">Zusätzlich: für Marktforschung freigeben (freiwillig)</span>
        <span class="text">
          Erlaubt uns, deine anonymen Angaben in eine Gesamtstatistik
          einfließen zu lassen, die wir an Hersteller und Händler
          weitergeben können. Damit finanzieren wir BenchMeister mit.
          Völlig unabhängig vom ersten Häkchen: Wenn du nur dein Ergebnis
          sehen willst, lass dieses hier einfach leer.
        </span>
      </label>
    </div>

    <button id="senden" disabled>Vergleichen</button>
    {{/* Hierher gewandert am 06.09.2026, aus der zweiten Zeile der Seite.
         Direkt unter dem Knopf steht sie an der Stelle, an der jemand
         zoegert, und beantwortet genau dessen Frage. Oben beantwortete
         sie eine Frage, die sich noch niemand gestellt hatte. */}}
    <p class="unter" style="margin:10px 0 0;font-size:12px">
      Bis zu diesem Klick ist nichts ins Internet gegangen. Übertragen wird
      genau das, was oben steht: kein Name, keine Seriennummer, keine
      Adresse.
    </p>
    <div id="meldung" class="meldung"></div>
  </div>

  {{/* Gekuerzt am 06.09.2026: Die ersten beiden Saetze standen nach dem
       Umbau doppelt, einmal hier und einmal direkt unter dem Knopf. Dort
       gehoeren sie hin, hier bleibt nur, was ueber den Klick hinausgeht. */}}
  <p class="fuss">
    Das Programm verändert nichts an deinem System, trägt sich nirgends ein
    und ist nach dem Schließen wieder weg.
  </p>

</div>

<script>
  const anzeigen = document.getElementById("anzeigen");
  const marktforschung = document.getElementById("marktforschung");
  const senden = document.getElementById("senden");
  const meldung = document.getElementById("meldung");
  const rohdaten = document.getElementById("rohdaten");

  // Der Rohdaten-Block muss ehrlich bleiben: Sobald sich das zweite
  // Häkchen ändert, ändert sich auch der Wert, der wirklich gesendet wird.
  // Deshalb wird die Anzeige mitgeführt statt einmal fest eingesetzt.
  function rohdatenAktualisieren() {
    try {
      const daten = JSON.parse(rohdaten.textContent);
      daten.p_consent_market_research = marktforschung.checked;
      rohdaten.textContent = JSON.stringify(daten, null, 2);
    } catch (e) { /* Anzeige ist Beiwerk, darf nie den Ablauf stören */ }
  }

  anzeigen.addEventListener("change", () => {
    senden.disabled = !anzeigen.checked;
  });
  marktforschung.addEventListener("change", rohdatenAktualisieren);

  /* Beim Laden EINMAL beide Zustaende nachziehen. Sieht ueberfluessig
     aus, ist es aber nicht: Firefox stellt beim Neuladen (F5) die
     Haekchen wieder her, ohne dabei ein change-Ereignis auszuloesen.
     Ohne diese zwei Zeilen passierte danach Folgendes:

     - Das erste Haekchen ist sichtbar gesetzt, der Knopf bleibt aber
       grau, weil er im HTML fest auf disabled steht. Sieht nach einem
       kaputten Programm aus.
     - Schlimmer: Ist das zweite Haekchen wiederhergestellt, steht im
       Rohdaten-Block weiterhin p_consent_market_research: false,
       gesendet wuerde aber true. Genau darueber steht die Zusage
       "genau das würde übertragen". Ein Block, der die Zustimmung
       falsch anzeigt, ist schlimmer als gar keiner.

     Gefunden bei der Durchsicht vor 1.0.6 am 29.08.2026. */
  senden.disabled = !anzeigen.checked;
  rohdatenAktualisieren();

  senden.addEventListener("click", async () => {
    senden.disabled = true;
    meldung.className = "meldung";
    meldung.textContent = "Wird übertragen ...";

    try {
      const antwort = await fetch("/consent", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          anzeigen: anzeigen.checked,
          marktforschung: marktforschung.checked,
        }),
      });
      const ergebnis = await antwort.json();

      if (!antwort.ok || ergebnis.fehler) {
        throw new Error(ergebnis.fehler || "Übertragung fehlgeschlagen");
      }

      meldung.className = "meldung gut";
      // Kein innerHTML mit zusammengebautem HTML: ergebnis.url kommt aus
      // der Antwort des Servers und damit mittelbar aus einer fremden
      // Antwort. Hier stand vorher eine Zeichenketten-Verkettung in ein
      // href-Attribut. Ausnutzbar waere das nur, wenn jemand die Antwort
      // von BenchMeister kontrolliert, aber die saubere Variante kostet
      // zwei Zeilen. Sicherheitsdurchsicht 27.08.2026.
      meldung.textContent = "Fertig. Dein Ergebnis: ";
      const verweis = document.createElement("a");
      verweis.href = ergebnis.url;
      verweis.textContent = ergebnis.url;
      meldung.appendChild(verweis);
      window.location.href = ergebnis.url;
    } catch (fehler) {
      meldung.className = "meldung fehler";
      meldung.textContent = "Hat nicht geklappt: " + fehler.message;
      senden.disabled = false;
    }
  });

  /* Anwesenheitsmeldung: ein Aufruf, der absichtlich nie beantwortet
     wird. Solange diese Seite offen ist, steht die Verbindung. Wird der
     Reiter geschlossen, bricht sie ab, und das Programm beendet sich.

     Das ist der verlaessliche Weg. Das sendBeacon weiter unten kam beim
     harten Schliessen eines Reiters nicht immer an, und ein Herzschlag
     per Zeitgeber wuerde in unsichtbaren Reitern gedrosselt. Die
     Begruendung im Langen steht in server.go bei /anwesend. */
  fetch("/anwesend").catch(function () {});

  /* Zusaetzlich, weil es schneller ist, wenn es denn ankommt:
     dem Programm Bescheid sagen, wenn diese Seite zugemacht wird.
     Ohne das lief die exe nach dem Schliessen des Fensters noch bis zu
     15 Minuten im Hintergrund weiter. Aus Sicht der Benutzerin ist diese
     Seite das Programm, also muss das Schliessen es auch beenden.
     Gefunden im PCGH-Forum am 28.08.2026.

     pagehide statt unload: unload verhindert, dass der Browser die Seite
     in seinen Vor-und-Zurueck-Speicher legt, und wird in mobilen
     Browsern oft gar nicht ausgeloest.

     sendBeacon statt fetch: Es ueberlebt das Schliessen des Fensters,
     ein normaler Aufruf wuerde dabei abgebrochen. */
  window.addEventListener("pagehide", function () {
    if (navigator.sendBeacon) {
      navigator.sendBeacon("/verlassen");
      return;
    }
    fetch("/verlassen", { method: "POST", keepalive: true }).catch(function () {});
  });

  /* Kommt die Seite ueber den Zurueck-Knopf aus dem Vor-und-Zurueck-
     Speicher, laedt der Browser sie nicht neu. Dann fehlt der Aufruf,
     der den Abschied von eben abblasen wuerde, also hier nachholen. */
  window.addEventListener("pageshow", function (ereignis) {
    if (ereignis.persisted) {
      fetch("/bleibt").catch(function () {});
    }
  });

  /* ----------------------------------------------------------------
     Lasttest und Ranglisten-Eintrag, ergaenzt am 06.09.2026.

     Der Server misst, diese Seite fragt im Sekundentakt nach dem Stand.
     Ein einziger Aufruf, der zwei Minuten offen bleibt, waere kuerzer
     und waere falsch: Eine Seite, auf der zwei Minuten nichts passiert,
     sieht kaputt aus, und abbrechen liesse sich auch nichts.
     ---------------------------------------------------------------- */
  const messenOk = document.getElementById("messen-ok");
  const messKnopf = document.getElementById("mess-knopf");
  const messStart = document.getElementById("mess-start");
  const messLauf = document.getElementById("mess-lauf");
  const messFertig = document.getElementById("mess-fertig");
  const messFortschritt = document.getElementById("mess-fortschritt");
  const messVerlauf = document.getElementById("mess-verlauf");
  const messAbbruch = document.getElementById("mess-abbruch");
  const messUrteil = document.getElementById("mess-urteil");
  const alias = document.getElementById("alias");
  const eintragKnopf = document.getElementById("eintrag-knopf");
  const eintragMeldung = document.getElementById("eintrag-meldung");

  let taktwerte = [];
  let takt = null;

  messenOk.addEventListener("change", () => {
    messKnopf.disabled = !messenOk.checked;
  });

  /* Der Name braucht drei Zeichen, siehe die Pruefung auf dem Server.
     Den Knopf vorher zu sperren erspart eine Fehlermeldung fuer etwas,
     das man auch vorher sehen kann. */
  alias.addEventListener("input", () => {
    eintragKnopf.disabled = alias.value.trim().length < 3;
  });

  function balkenZeichnen() {
    if (taktwerte.length === 0) return;
    const hoechster = Math.max(...taktwerte);
    /* Die Skala beginnt bei 70 Prozent des hoechsten Werts, nicht bei
       null. Sonst sieht ein Abfall von 4700 auf 3400 MHz aus wie ein
       Rundungsfehler, und genau dieser Abfall ist der Befund. */
    const boden = hoechster * 0.7;
    messVerlauf.innerHTML = taktwerte
      .map((w) => {
        const anteil = Math.max(4, ((w - boden) / (hoechster - boden || 1)) * 100);
        return '<i style="height:' + anteil.toFixed(1) + '%"></i>';
      })
      .join("");
  }

  function fertigZeigen(stand) {
    clearInterval(takt);
    messLauf.hidden = true;
    messFertig.hidden = false;

    if (stand.fehler) {
      messUrteil.textContent = stand.fehler;
      document.getElementById("eintrag").hidden = true;
      return;
    }
    if (stand.abgebrochen) {
      messUrteil.textContent =
        "Abgebrochen. Eine abgebrochene Messung sagt nichts über Dauerlast aus, deshalb kommt sie nicht in die Rangliste.";
      document.getElementById("eintrag").hidden = true;
      return;
    }

    const prozent = (stand.gehalten * 100);
    document.getElementById("mess-gehalten").textContent =
      prozent.toFixed(1).replace(".", ",") + " %";
    document.getElementById("mess-dauer").textContent = stand.dauer_mhz + " MHz";
    document.getElementById("mess-spitze").textContent = stand.spitze_mhz + " MHz";

    const saetze = {
      "stabil": "Deine Kühlung hält den Takt. Da ist nichts zu tun.",
      "leichter Abfall":
        "Leichter Abfall unter Dauerlast. Das ist bei vielen Serienkühlern normal.",
      "drosselt deutlich":
        "Der Takt fällt deutlich ab. Meistens liegt das an Staub im Kühler, alter Wärmeleitpaste oder zu wenig Luft im Gehäuse.",
    };
    messUrteil.textContent = saetze[stand.urteil] || "";
    messFertig.className =
      stand.urteil === "stabil" ? "urteil-gut"
      : stand.urteil === "leichter Abfall" ? "urteil-mittel"
      : "urteil-schlecht";
  }

  async function standHolen() {
    try {
      const antwort = await fetch("/lasttest/stand");
      const stand = await antwort.json();

      if (stand.aktuell_mhz > 0) {
        taktwerte.push(stand.aktuell_mhz);
        balkenZeichnen();
      }
      if (stand.laeuft) {
        const rest = Math.max(0, stand.gesamt - stand.sekunden);
        messFortschritt.textContent =
          "Läuft, noch " + rest + " von " + stand.gesamt + " Sekunden.";
        return;
      }
      if (stand.fertig || stand.fehler) fertigZeigen(stand);
    } catch (e) {
      /* Netzwerkfehler zum eigenen Rechner heisst: Das Programm ist weg.
         Dann hat das Weiterfragen keinen Zweck. */
      clearInterval(takt);
    }
  }

  messKnopf.addEventListener("click", async () => {
    messKnopf.disabled = true;
    taktwerte = [];
    try {
      const antwort = await fetch("/lasttest/start", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ zugestimmt: messenOk.checked }),
      });
      const stand = await antwort.json();
      if (stand.fehler) {
        messFortschritt.textContent = stand.fehler;
        messStart.hidden = true;
        messLauf.hidden = false;
        messAbbruch.hidden = true;
        return;
      }
      messStart.hidden = true;
      messLauf.hidden = false;
      messFortschritt.textContent = "Läuft ...";
      takt = setInterval(standHolen, 1000);
    } catch (e) {
      messKnopf.disabled = false;
      messFortschritt.textContent = "Die Messung ließ sich nicht starten.";
    }
  });

  messAbbruch.addEventListener("click", async () => {
    messAbbruch.disabled = true;
    await fetch("/lasttest/abbrechen", { method: "POST" });
    setTimeout(standHolen, 300);
  });

  eintragKnopf.addEventListener("click", async () => {
    eintragKnopf.disabled = true;
    eintragMeldung.className = "meldung";
    eintragMeldung.textContent = "Wird eingetragen ...";
    try {
      const antwort = await fetch("/rangliste/eintragen", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ alias: alias.value.trim(), zugestimmt: true }),
      });
      const daten = await antwort.json();

      if (daten.fehler) {
        eintragMeldung.className = "meldung fehler";
        eintragMeldung.textContent = daten.fehler;
        eintragKnopf.disabled = false;
        return;
      }

      /* Der Loeschschluessel wird EINMAL gezeigt und steht nirgends
         sonst. Deshalb steht er gross da und nicht in einer Randnotiz:
         Wer ihn verliert, kommt an seinen Eintrag nicht mehr heran. */
      eintragMeldung.className = "meldung gut";
      eintragMeldung.innerHTML =
        "Eingetragen. Deine Messung steht jetzt auf " +
        '<a href="https://www.benchmeister.de/rangliste" target="_blank" rel="noopener">benchmeister.de/rangliste</a>.' +
        '<div class="unter" style="margin-top:10px;font-size:13px">' +
        "Mit diesem Schlüssel kannst du den Eintrag später löschen. " +
        "Er steht nirgends sonst, also am besten jetzt sichern:" +
        '</div><div class="schluessel">' + daten.loeschschluessel + "</div>";
      alias.disabled = true;
    } catch (e) {
      eintragMeldung.className = "meldung fehler";
      eintragMeldung.textContent = "Der Eintrag ließ sich nicht absenden.";
      eintragKnopf.disabled = false;
    }
  });
</script>
</body>
</html>
